# Docket configuration. Copy to .env and fill in. Values are never logged.
# Every variable below says Required., Optional. or Group. (all-or-none with its neighbours),
# what it does, its format, and its default. See docs/deployment.md.

# --- Core ---

# Required. App database connection; may be a pooled URL (e.g. Neon "-pooler"). Format: postgres:// or postgresql://
# No default.
DATABASE_URL=postgres://docket:docket@localhost:5432/docket

# Optional. Direct (non-pooled) URL used for migrations. Empty means unset.
# Default: the value of DATABASE_URL.
# DATABASE_URL_DIRECT=postgres://docket:docket@localhost:5432/docket

# Optional. Connection pool size, integer 1-100.
# Default: 10.
# DATABASE_POOL_MAX=10

# Optional. Apply migrations before serving: true or false.
# Default: true.
# MIGRATE_ON_START=true

# Optional. Runtime mode: development, production or test. The Docker image sets production.
# Default: unset (Next.js decides).
# NODE_ENV=development

# Optional. Port the web server listens on, integer 1-65535.
# Default: 3000.
# PORT=3000

# Optional. Interface the web server binds to; no whitespace. The Docker image sets 0.0.0.0.
# Default: Next.js default.
# HOSTNAME=0.0.0.0

# --- Auth ---

# Required. Signs session cookies, at least 32 characters. Generate: openssl rand -base64 32
# No default.
BETTER_AUTH_SECRET=

# Required. Public base URL people use to reach Docket: absolute http(s) URL, no path. Used for cookies,
# origin checks and invitation links; it must equal the address in the browser.
# No default.
BETTER_AUTH_URL=http://localhost:3000

# Required. AES-256-GCM key for secrets at rest: 32 bytes as base64 (44 chars) or hex (64 chars).
# Generate: openssl rand -base64 32. Losing it makes stored account credentials unreadable.
# No default.
CREDENTIALS_ENCRYPTION_KEY=

# Optional. Email of the first account, created at startup only if no accounts exist.
# Set together with BOOTSTRAP_ADMIN_PASSWORD.
# No default.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Optional. Password of the first account, 12-128 characters. Set together with BOOTSTRAP_ADMIN_EMAIL.
# No default.
# BOOTSTRAP_ADMIN_PASSWORD=

# Optional. Display name of the first account, 1-100 characters.
# Default: Admin.
# BOOTSTRAP_ADMIN_NAME=Admin

# Optional. Invitation lifetime in days, integer 1-90.
# Default: 7.
# INVITATION_TTL_DAYS=7

# Optional. Comma-separated header names holding the real client IP, set by your reverse proxy
# (e.g. x-real-ip). Run behind a proxy that overwrites the header; see README "Sessions and rate limits".
# Default: Better Auth's x-forwarded-for.
# TRUSTED_IP_HEADERS=x-real-ip

# Optional. Comma-separated IPs or CIDR ranges of your reverse proxy.
# No default.
# TRUSTED_PROXIES=10.0.0.0/8

# --- Scheduler ---

# Optional. Bearer secret for POST /api/internal/tick, at least 32 characters. Generate: openssl rand -base64 32.
# When unset or empty the endpoint refuses every call (401).
# No default.
# TICK_SECRET=

# Optional. Seconds between ticks in the worker and the in-process loop, integer 30-60.
# Default: 60.
# WORKER_INTERVAL_SECONDS=60

# Optional. Run the tick loop inside the web process (single-service hosts): true or false.
# Default: false.
# RUN_WORKER_IN_PROCESS=false

# Optional. Time budget per tick in seconds, integer 5-25.
# Default: 20.
# SCHEDULER_TICK_BUDGET_SECONDS=20

# Optional. Most targets advanced per tick, integer 1-500.
# Default: 25.
# SCHEDULER_TICK_MAX_ITEMS=25

# Optional. Timeout for one provider call in seconds, integer 1-20, less than the tick budget.
# Default: 10.
# SCHEDULER_PROVIDER_TIMEOUT_SECONDS=10

# Optional. How long a claimed target is held before it counts as abandoned, seconds, integer 60-3600,
# greater than tick budget + provider timeout.
# Default: 300.
# SCHEDULER_LEASE_SECONDS=300

# Optional. Failed attempts at a step before the target is marked failed, integer 1-20.
# Default: 5.
# PUBLISH_MAX_ATTEMPTS=5

# Optional. First retry delay in seconds, integer 1-3600; doubles per attempt.
# Default: 60.
# PUBLISH_BACKOFF_BASE_SECONDS=60

# Optional. Retry delay cap in seconds, integer 1-86400, at least the base.
# Default: 3600.
# PUBLISH_BACKOFF_MAX_SECONDS=3600

# Optional. A multi-step publish still unfinished this many hours after its first step fails, integer 1-168.
# Default: 24.
# PUBLISH_MAX_DURATION_HOURS=24

# Optional. Refresh credentials expiring within this many hours, integer 1-720.
# Default: 72.
# TOKEN_REFRESH_WINDOW_HOURS=72

# Optional. The scheduler health indicator warns after this many minutes without a tick, integer 1-1440.
# Default: 5.
# SCHEDULER_STALE_AFTER_MINUTES=5

# Optional. Warn when an explicit time is within this many minutes of a queued post on the same account,
# integer 0-1440 (0 = no warning).
# Default: 30.
# EXPLICIT_TIME_WARNING_MINUTES=30

# Optional. How many days ahead "add to queue" searches for a free slot, integer 7-730.
# Default: 366.
# QUEUE_HORIZON_DAYS=366

# Optional. Most generation-job items a single worker tick processes, integer 1-10.
# Default: 2.
# GENERATION_TICK_MAX_ITEMS=2

# Optional. Allow connecting mock accounts (offline walkthrough, development): true or false.
# Default: true, except false when NODE_ENV=production. Set true to use the mock provider on a production image.
# MOCK_PROVIDER_ENABLED=true

# --- Media storage ---
# Photo/video uploads go to S3-compatible object storage (Cloudflare R2, AWS S3, or MinIO offline).
# Leave the four Group variables empty to disable media. Setting any one requires all four, and setting
# the optional S3_* variables without them is an error. Facebook, Instagram and Threads fetch images by URL, so
# the bucket must be publicly reachable (see docs/storage.md).

# Group. Bucket name, 3-63 characters of [a-z0-9.-].
# No default.
# S3_BUCKET=docket-media

# Group. Access key id. Never logged.
# No default.
# S3_ACCESS_KEY_ID=

# Group. Secret access key. Never logged or shown.
# No default.
# S3_SECRET_ACCESS_KEY=

# Group. Public base URL media is served from: absolute http(s), no query or fragment; https:// is required in
# production unless the host is localhost or 127.0.0.1. R2 custom domain: https://media.example.com
# No default.
# S3_PUBLIC_BASE_URL=https://media.example.com

# Optional. Absolute http(s) endpoint. R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com; offline Compose: http://minio:9000
# Default: the AWS endpoint.
# S3_ENDPOINT=

# Optional. Region. Use auto for R2, the bucket's region for S3, anything for MinIO.
# Default: auto.
# S3_REGION=auto

# Optional. Path-style addressing: true or false. Use true for MinIO.
# Default: false.
# S3_FORCE_PATH_STYLE=false

# Optional. Checksum mode: when_required or when_supported (when_required is R2-compatible).
# Default: when_required.
# S3_CHECKSUMS=when_required

# Optional. How thumbnails are served: public or signed (signed uses 1-hour signed URLs).
# Default: public.
# S3_PREVIEW_URLS=public

# Optional. Largest upload in MB, integer 1-25. The request limit is 26 MB (next.config.ts).
# Default: 20.
# MEDIA_MAX_UPLOAD_MB=20

# Optional. Largest decoded image in megapixels, integer 1-100 (decompression-bomb guard).
# Default: 50.
# MEDIA_MAX_MEGAPIXELS=50

# --- Generator (LLM) ---
# Leave LLM_PROVIDER empty to disable generation; the rest of Docket works without it. Setting any LLM_* or
# *_API_KEY variable without LLM_PROVIDER is an error. There is deliberately no model default. See docs/generator.md

# Optional. Generator provider: openai or anthropic.
# No default. Generation is off when unset.
# LLM_PROVIDER=openai

# Optional. Model id your provider account can use; required when LLM_PROVIDER is set. No spaces, up to 200 characters.
# No default.
# LLM_MODEL=

# Optional. OpenAI API key; required when LLM_PROVIDER=openai. Never logged.
# No default.
# OPENAI_API_KEY=

# Optional. Anthropic API key; required when LLM_PROVIDER=anthropic. Never logged.
# No default.
# ANTHROPIC_API_KEY=

# Optional. Timeout for one model call in seconds, integer 10-600.
# Default: 90.
# LLM_TIMEOUT_SECONDS=90

# Optional. Output token cap per call, integer 256-32000.
# Default: 4000.
# LLM_MAX_OUTPUT_TOKENS=4000

# --- Meta ---
# Facebook Pages and Instagram. Leave META_APP_ID and META_APP_SECRET empty to disable. See docs/meta-setup.md

# Group. Meta app id.
# No default.
META_APP_ID=

# Group. Meta app secret. Never logged.
# No default.
META_APP_SECRET=

# Optional. Graph API version.
# Default: v26.0.
# META_GRAPH_VERSION=v26.0

# Optional. Facebook Login for Business configuration id.
# No default.
# META_LOGIN_CONFIG_ID=

# --- Threads ---
# Leave THREADS_APP_ID and THREADS_APP_SECRET empty to disable. Threads needs an HTTPS callback address that is
# not localhost; see docs/meta-setup.md#local-https-for-threads

# Group. Threads app id.
# No default.
THREADS_APP_ID=

# Group. Threads app secret. Never logged.
# No default.
THREADS_APP_SECRET=

# Optional. Threads Graph API base URL.
# Default: https://graph.threads.com.
# THREADS_GRAPH_BASE=https://graph.threads.com

# --- Public API and webhooks ---
# No variables. Limits are constants in src/server/api (JSON_BODY_LIMIT, rate limit, idempotency window) and
# src/server/services/webhooks (ROTATION_OVERLAP_MS, SIGNATURE_TOLERANCE_SECONDS). See docs/n8n.md

# --- Compose-only (not read by Docket) ---
# Used by docker-compose.yml's "offline" profile.

# Optional. MinIO image for the offline profile.
# Default: minio/minio:RELEASE.2025-09-07T16-13-09Z.
# MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z

# Optional. MinIO root user for the offline profile.
# Default: docket-dev.
# MINIO_ROOT_USER=docket-dev

# Optional. MinIO root password for the offline profile.
# Default: docket-dev-secret.
# MINIO_ROOT_PASSWORD=docket-dev-secret

# --- Smoke script (not read by Docket) ---

# Optional. Address the smoke script waits for and calls.
# Default: http://web:3000.
# SMOKE_BASE_URL=http://web:3000
