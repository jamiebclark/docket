# Docket configuration. Copy to .env and fill in. Values are never logged.

# Required. App connection; may be a pooled URL (e.g. Neon "-pooler").
# Format: postgres:// or postgresql://
DATABASE_URL=postgres://docket:docket@localhost:5432/docket

# Optional. Direct (non-pooled) URL used for migrations. Defaults to DATABASE_URL.
# DATABASE_URL_DIRECT=

# Optional. pg.Pool size, integer 1-100. Default 10.
# DATABASE_POOL_MAX=10

# Required. Signs session cookies, at least 32 characters.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required. Public base URL (absolute http(s) URL, no trailing path). Used for
# cookies, origin checks and invitation links.
BETTER_AUTH_URL=http://localhost:3000

# Required. AES-256-GCM key for secrets at rest: 32 bytes as base64 (44 chars)
# or hex (64 chars).
# Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Optional. First account, created at startup only if no accounts exist.
# BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD must be set together.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Password: 12-128 characters.
# BOOTSTRAP_ADMIN_PASSWORD=
# Display name, 1-100 characters. Default "Admin".
# BOOTSTRAP_ADMIN_NAME=Admin

# Optional. Invitation lifetime in days, integer 1-90. Default 7.
# INVITATION_TTL_DAYS=7

# Optional. Comma-separated header names holding the real client IP, set by your
# reverse proxy (e.g. x-real-ip). Default: Better Auth's x-forwarded-for.
# Run behind a proxy that overwrites this header; see README "Sessions and rate limits".
# TRUSTED_IP_HEADERS=x-real-ip
# Optional. Comma-separated IPs or CIDR ranges of your reverse proxy.
# TRUSTED_PROXIES=10.0.0.0/8

# Optional. Apply migrations before serving: true or false. Default true.
# MIGRATE_ON_START=true

# Optional. development | production | test.
# NODE_ENV=development

# Optional. Next.js defaults: PORT=3000, HOSTNAME=0.0.0.0 in the Docker image.
# PORT=3000
# HOSTNAME=0.0.0.0
