# Docket configuration. Copy to .env and fill in. Values are never logged.

# Required. App connection; may be a pooled URL (e.g. Neon "-pooler").
# Format: postgres:// or postgresql://
DATABASE_URL=postgres://docket:docket@localhost:5432/docket

# Optional. Direct (non-pooled) URL used for migrations. Defaults to DATABASE_URL.
# DATABASE_URL_DIRECT=

# Optional. pg.Pool size, integer 1-100. Default 10.
# DATABASE_POOL_MAX=10

# Required. Signs session cookies, at least 32 characters.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required. Public base URL (absolute http(s) URL, no trailing path). Used for
# cookies, origin checks and invitation links.
BETTER_AUTH_URL=http://localhost:3000

# Required. AES-256-GCM key for secrets at rest: 32 bytes as base64 (44 chars)
# or hex (64 chars).
# Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Optional. First account, created at startup only if no accounts exist.
# BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD must be set together.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Password: 12-128 characters.
# BOOTSTRAP_ADMIN_PASSWORD=
# Display name, 1-100 characters. Default "Admin".
# BOOTSTRAP_ADMIN_NAME=Admin

# Optional. Invitation lifetime in days, integer 1-90. Default 7.
# INVITATION_TTL_DAYS=7

# Optional. Comma-separated header names holding the real client IP, set by your
# reverse proxy (e.g. x-real-ip). Default: Better Auth's x-forwarded-for.
# Run behind a proxy that overwrites this header; see README "Sessions and rate limits".
# TRUSTED_IP_HEADERS=x-real-ip
# Optional. Comma-separated IPs or CIDR ranges of your reverse proxy.
# TRUSTED_PROXIES=10.0.0.0/8

# Optional. Apply migrations before serving: true or false. Default true.
# MIGRATE_ON_START=true

# Optional. development | production | test.
# NODE_ENV=development

# Optional. Next.js defaults: PORT=3000, HOSTNAME=0.0.0.0 in the Docker image.
# PORT=3000
# HOSTNAME=0.0.0.0

# --- Scheduling engine ---

# Optional. Bearer secret for POST /api/internal/tick, at least 32 characters.
# Unset or empty disables the HTTP trigger (the endpoint answers 404).
# Generate: openssl rand -base64 32
# TICK_SECRET=

# Optional. Seconds between ticks in the worker and the in-process loop, integer 30-60. Default 60.
# WORKER_INTERVAL_SECONDS=60

# Optional. Run the tick loop inside the web process (single-service hosts): true or false. Default false.
# RUN_WORKER_IN_PROCESS=false

# Optional. Time budget per tick in seconds, integer 5-25. Default 20.
# SCHEDULER_TICK_BUDGET_SECONDS=20

# Optional. Most targets advanced per tick, integer 1-500. Default 25.
# SCHEDULER_TICK_MAX_ITEMS=25

# Optional. Timeout for one provider call in seconds, integer 1-20, less than the tick budget. Default 10.
# SCHEDULER_PROVIDER_TIMEOUT_SECONDS=10

# Optional. How long a claimed target is held before it counts as abandoned, in seconds,
# integer 60-3600, greater than tick budget + provider timeout. Default 300.
# SCHEDULER_LEASE_SECONDS=300

# Optional. Failed attempts at a step before the target is marked failed, integer 1-20. Default 5.
# PUBLISH_MAX_ATTEMPTS=5

# Optional. First retry delay in seconds, integer 1-3600; doubles per attempt. Default 60.
# PUBLISH_BACKOFF_BASE_SECONDS=60

# Optional. Retry delay cap in seconds, integer 1-86400, at least the base. Default 3600.
# PUBLISH_BACKOFF_MAX_SECONDS=3600

# Optional. A multi-step publish still unfinished this many hours after its first step fails,
# integer 1-168. Default 24.
# PUBLISH_MAX_DURATION_HOURS=24

# Optional. Refresh credentials expiring within this many hours, integer 1-720. Default 72.
# TOKEN_REFRESH_WINDOW_HOURS=72

# Optional. The scheduler health indicator warns after this many minutes without a tick,
# integer 1-1440. Default 5.
# SCHEDULER_STALE_AFTER_MINUTES=5

# Optional. Warn when an explicit time is within this many minutes of a queued post on the same
# account, integer 0-1440 (0 = no warning). Default 30.
# EXPLICIT_TIME_WARNING_MINUTES=30

# Optional. How many days ahead "add to queue" searches for a free slot, integer 7-730. Default 366.
# QUEUE_HORIZON_DAYS=366

# Optional. Allow connecting mock accounts (offline development): true or false.
# Default true, except false when NODE_ENV=production.
# MOCK_PROVIDER_ENABLED=true

# --- Media storage ---
# Photo/video uploads go to S3-compatible object storage (Cloudflare R2, AWS S3, or MinIO offline).
# Leave the four group variables below empty to disable media. Setting any one requires all four,
# and setting the optional S3_* variables without them is an error.

# Group. Bucket name, 3-63 characters of [a-z0-9.-].
# S3_BUCKET=docket-media

# Group. Access key id. Never logged.
# S3_ACCESS_KEY_ID=

# Group. Secret access key. Never logged or shown.
# S3_SECRET_ACCESS_KEY=

# Group. Public base URL media is served from, absolute http(s) with no query or fragment.
# https:// is required in production unless the host is localhost or 127.0.0.1.
# R2 custom domain: https://media.example.com
# S3: https://<bucket>.s3.<region>.amazonaws.com
# Offline: http://localhost:9000/docket-media
# S3_PUBLIC_BASE_URL=https://media.example.com

# Optional. Absolute http(s) endpoint. Default: the AWS endpoint.
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com   Offline (inside Compose): http://minio:9000
# S3_ENDPOINT=

# Optional. Default auto. Use auto for R2, the bucket's region for S3, anything for MinIO.
# S3_REGION=auto

# Optional. true or false. Default false. Use true for MinIO.
# S3_FORCE_PATH_STYLE=false

# Optional. when_required or when_supported. Default when_required (R2-compatible).
# S3_CHECKSUMS=when_required

# Optional. public or signed. Default public. signed serves thumbnails via 1-hour signed URLs.
# S3_PREVIEW_URLS=public

# Optional. Largest upload in MB, integer 1-25. Default 20. The request limit is 26 MB (next.config.ts).
# MEDIA_MAX_UPLOAD_MB=20

# Optional. Largest decoded image in megapixels, integer 1-100. Default 50 (decompression-bomb guard).
# MEDIA_MAX_MEGAPIXELS=50

# Compose-only (docker-compose.yml "offline" profile; not read by Docket).
# MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
# MINIO_ROOT_USER=docket-dev
# MINIO_ROOT_PASSWORD=docket-dev-password

# Meta (Facebook Pages and Instagram). Leave META_APP_ID and META_APP_SECRET empty to disable. See docs/meta-setup.md
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v26.0
# META_LOGIN_CONFIG_ID=

# Threads. Leave THREADS_APP_ID and THREADS_APP_SECRET empty to disable. Threads needs an HTTPS callback address that
# is not localhost; see docs/meta-setup.md#local-https-for-threads
THREADS_APP_ID=
THREADS_APP_SECRET=
# THREADS_GRAPH_BASE=https://graph.threads.com
